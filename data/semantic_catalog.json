{
  "documents": [
    {
      "id": "metric.revenue",
      "kind": "metric",
      "name": "销售收入",
      "description": "扣除折扣前的销售总收入。计算总收入时使用 SUM(revenue)。",
      "table": "sales",
      "columns": ["revenue"],
      "formula": "SUM(sales.revenue)",
      "aliases": ["revenue", "sales", "income", "turnover", "total revenue", "销售额", "收入", "营收"]
    },
    {
      "id": "metric.order_count",
      "kind": "metric",
      "name": "订单数量",
      "description": "销售记录数量；演示数据集中每一行代表一个订单。",
      "table": "sales",
      "columns": ["id"],
      "formula": "COUNT(sales.id)",
      "aliases": ["orders", "transactions", "订单数", "订单量"]
    },
    {
      "id": "metric.average_order_value",
      "kind": "metric",
      "name": "平均客单价",
      "description": "每个订单的平均销售总收入。",
      "table": "sales",
      "columns": ["revenue", "id"],
      "formula": "SUM(sales.revenue) / NULLIF(COUNT(sales.id), 0)",
      "aliases": ["AOV", "average revenue per order", "客单价"]
    },
    {
      "id": "metric.units_sold",
      "kind": "metric",
      "name": "销售数量",
      "description": "已售产品或服务的总数量。",
      "table": "sales",
      "columns": ["quantity"],
      "formula": "SUM(sales.quantity)",
      "aliases": ["volume", "quantity sold", "销量", "销售数量"]
    },
    {
      "id": "metric.average_discount",
      "kind": "metric",
      "name": "平均折扣率",
      "description": "订单级折扣比例的算术平均值，取值范围为 0 到 1。",
      "table": "sales",
      "columns": ["discount"],
      "formula": "AVG(sales.discount)",
      "aliases": ["discount rate", "mean discount", "平均折扣", "折扣率"]
    },
    {
      "id": "dimension.region",
      "kind": "dimension",
      "name": "销售地区",
      "description": "用于分组和比较的地理销售区域。",
      "table": "sales",
      "columns": ["region"],
      "formula": "sales.region",
      "aliases": ["area", "market", "地区", "区域"]
    },
    {
      "id": "dimension.category",
      "kind": "dimension",
      "name": "产品类别",
      "description": "所购产品或服务的商业分类。",
      "table": "sales",
      "columns": ["category"],
      "formula": "sales.category",
      "aliases": ["product type", "segment", "品类", "产品类别"]
    },
    {
      "id": "dimension.order_month",
      "kind": "dimension",
      "name": "订单月份",
      "description": "从 order_date 派生的自然月，用于时间序列分析。",
      "table": "sales",
      "columns": ["order_date"],
      "formula": "strftime('%Y-%m', sales.order_date)",
      "aliases": ["monthly", "month", "月份", "按月"]
    },
    {
      "id": "policy.gross_revenue",
      "kind": "business_rule",
      "name": "收入解释口径",
      "description": "演示数据中的 revenue 字段表示总收入；除非用户明确要求估算净收入，否则不要再次扣除折扣。",
      "table": "sales",
      "columns": ["revenue", "discount"],
      "formula": null,
      "aliases": ["net revenue", "gross revenue", "revenue definition", "收入定义"]
    }
  ]
}
